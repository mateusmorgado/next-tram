<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch"/>
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_tram_watch"
        android:label="@string/watch_app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NextTramWatch">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true"/>

        <activity
            android:name=".WatchMainActivity"
            android:exported="true"
            android:label="@string/watch_app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <service
            android:name=".NextTramWearTileService"
            android:description="@string/watch_tile_description"
            android:exported="true"
            android:icon="@drawable/ic_tram_watch"
            android:label="@string/watch_tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER"/>
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/ic_tram_watch"/>
        </service>
    </application>
</manifest>
